rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && (request.auth.uid == 'bulbnZbmC4PgH8tUAOjfPPLE7pA3' || (request.auth.token.get('email', '') == 'mooncurvv@gmail.com' && request.auth.token.get('email_verified', false) == true)); }
    function approved() {
      return admin() || (signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid) && !admin()
        && request.resource.data.keys().hasOnly(['uid','email','name','status','consentAt','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','email','status','consentAt','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        // 5.0.1 카카오 가입은 이메일이 없을 수 있다. 이메일(비밀번호) 가입은 메일 인증을 마쳐야 신청된다
        && request.resource.data.email == request.auth.token.get('email', '')
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 30))
        && (request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password' || request.auth.token.get('email_verified', false) == true)
        // 5.0.2 대표님(2026-11-25): 이용 신청 없이 가입하면 바로 쓴다(동의하면 곧바로 approved). 반려는 관리자만.
        && request.resource.data.status in ['pending','approved']
        && request.resource.data.consentAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 5.0.2 예전에 '승인 대기'로 남은 본인은 스스로 승인으로 바꿀 수 있다(반려된 계정은 안 됨). 이메일 가입은 메일 인증 뒤에만.
      allow update: if owner(uid) && !admin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status == 'approved' && request.resource.data.updatedAt == request.time
        && (request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password' || request.auth.token.get('email_verified', false) == true);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewerUid','updatedAt'])
        && request.resource.data.status in ['pending','approved','rejected']
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 4.17.0 플러스 전환: 관리자만 plan을 바꾼다(본인은 못 바꿈, 결제가 붙으면 같은 칸을 씀)
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan','planBy','planAt','updatedAt'])
        && request.resource.data.plan in ['free','plus']
        && request.resource.data.planBy == request.auth.uid
        && request.resource.data.planAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 5.0.2 대표님: 관리자가 가입한 사람 중에서 코치 권한을 준다(테스트·코치 회원)
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coach','coachBy','coachAt','updatedAt'])
        && request.resource.data.coach is bool
        && request.resource.data.coachBy == request.auth.uid
        && request.resource.data.coachAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 4.11.0 계정 삭제: 본인은 자기 계정 문서를 지울 수 있다(하위 기록·초안을 먼저 지운 뒤).
      allow delete: if owner(uid);
    }
    // 4.15.0 관리로그(대표님 결정 2026-11-23: 베타 기간 동안 관리자 전체 열람·수정, 정식 서비스 때 '허락받은 동안만'으로 전환)
    // 관리자 쓰기는 같은 일괄 저장 안에 접근 기록(accessLog/{recordId}__r{revision})이 함께 생겨야 하고, 최근 60분 안에 로그인한 상태여야 한다.
    // 4.27.0 전수검사 B-08: 운영자 열람은 선택 동의. 사용자가 명시적으로 거부(operator == false)했으면 관리자도 기록을 읽거나 고칠 수 없다.
    function operatorAllowed(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/meta/consent)
        || get(/databases/$(database)/documents/users/$(uid)/meta/consent).data.items.get('operator', true) != false;
    }
    function recentLogin() { return request.auth.token.auth_time > request.time.toMillis() / 1000 - 3600; }
    function auditedAdminWrite(uid, recordId) {
      return admin() && recentLogin() && operatorAllowed(uid)
        && existsAfter(/databases/$(database)/documents/users/$(uid)/accessLog/$(recordId + '__r' + string(request.resource.data.revision)))
        && auditLogMatches(getAfter(/databases/$(database)/documents/users/$(uid)/accessLog/$(recordId + '__r' + string(request.resource.data.revision))).data, recordId);
    }
    function auditLogMatches(log, recordId) {
      return log.adminUid == request.auth.uid && log.get('recordId', '') == recordId
        && log.get('revision', -1) == request.resource.data.revision && log.get('after', null) == request.resource.data.payload
        && log.action in ['create','update','delete'];
    }
    // 4.17.0 동의 기록(계정 단위): 본인만 읽고 쓰며, 칸과 크기를 좁게 제한한다.
    match /users/{uid}/meta/{docId} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && docId == 'consent'
        && request.resource.data.keys().hasOnly(['version','items','at'])
        && request.resource.data.version is string && request.resource.data.version.size() <= 40
        && request.resource.data.items is map && request.resource.data.items.size() <= 20
        && request.resource.data.at == request.time;
      // 4.17.0 보안 2차: 카탈로그 요청 하루 개수(요청 문서와 같은 일괄 저장에서 1씩만 늘고, 하루 20건까지)
      allow create, update: if owner(uid) && docId == 'requestQuota' && validQuota();
      allow list: if owner(uid);
      allow delete: if owner(uid);
    }
    function utcDay() { return math.floor(request.time.toMillis() / 86400000); }
    function validQuota() {
      let d = request.resource.data;
      let fresh = resource == null || resource.data.day != d.day;
      return d.keys().hasOnly(['day','n','lastId','updatedAt'])
        && d.day == utcDay() && d.updatedAt == request.time
        && d.lastId is string && d.lastId.size() > 0 && d.lastId.size() <= 128
        && d.n == (fresh ? 1 : resource.data.n + 1) && d.n <= 20
        && !exists(/databases/$(database)/documents/catalogRequests/$(d.lastId))
        && existsAfter(/databases/$(database)/documents/catalogRequests/$(d.lastId));
    }
    match /users/{uid}/accessLog/{logId} {
      allow get, list: if owner(uid) || admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['adminUid','adminEmail','action','recordId','revision','reason','before','after','at'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminEmail == request.auth.token.email
        && request.resource.data.action in ['create','update','delete','view']
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && (request.resource.data.get('before', null) == null || (request.resource.data.before is string && request.resource.data.before.size() < 800000))
        && (request.resource.data.get('after', null) == null || (request.resource.data.after is string && request.resource.data.after.size() < 800000))
        && request.resource.data.at == request.time;
      allow update: if false;
      // 계정 삭제 때 본인이 자기 접근 기록도 지운다.
      allow delete: if owner(uid);
    }
    match /users/{uid}/records/{recordId} {
      allow read: if (owner(uid) && approved()) || (admin() && operatorAllowed(uid));
      allow create: if validRecord() && request.resource.data.revision == 1
        && ((owner(uid) && approved()) || auditedAdminWrite(uid, recordId));
      allow update: if validRecord() && request.resource.data.revision == resource.data.revision + 1
        && ((owner(uid) && approved()) || auditedAdminWrite(uid, recordId));
      // Deletions use versioned null payloads, never remove tombstones.
      // 4.11.0 예외: 계정 삭제 때 본인은 자기 기록 문서를 실제로 지운다(승인이 취소된 뒤에도 지울 수 있게 approved는 묻지 않음).
      allow list: if owner(uid) || (admin() && operatorAllowed(uid));
      allow delete: if owner(uid);
      function validRecord() {
        return request.resource.data.keys().hasOnly(['revision','payload','updatedAt'])
          && request.resource.data.revision is int
          && (request.resource.data.payload == null || (request.resource.data.payload is string && request.resource.data.payload.size() < 800000))
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /users/{uid}/aiDrafts/{draftId} {
      function draftShape() {
        return request.resource.data.keys().hasOnly([
          'id','requestId','type','status','schemaVersion','sourceModel',
          'originalUtterance','parsedData','uncertainty','evidence',
          'createdAt','updatedAt','finalRecordIds','reviewedAt','reviewedData'
        ])
          && request.resource.data.keys().hasAll([
            'id','requestId','type','status','schemaVersion','sourceModel',
            'originalUtterance','parsedData','uncertainty','evidence',
            'createdAt','updatedAt'
          ])
          && request.resource.data.id == draftId
          && request.resource.data.requestId == draftId
          && request.resource.data.type in ['meal','workout','body','food','machine','exercise']
          && request.resource.data.schemaVersion == 1
          && request.resource.data.sourceModel is string
          && request.resource.data.sourceModel.size() <= 100
          && request.resource.data.originalUtterance is string
          && request.resource.data.originalUtterance.size() <= 4000
          && request.resource.data.parsedData is map
          && request.resource.data.uncertainty is map
          && request.resource.data.evidence is map
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }
      allow get, list: if owner(uid) && approved();
      // 4.0.0 코치 모드(지금은 마스터 계정만): 연동된 코치는 자기가 보낸 수업 초안만 확인하고, 운동 초안만 새로 만든다. 처리는 회원만.
      allow get: if coachMaster() && !owner(uid) && (resource == null || resource.data.evidence.trainerUid == request.auth.uid);
      allow create: if coachMaster() && !owner(uid) && draftShape()
        && request.resource.data.status == 'pending'
        && request.resource.data.type == 'workout'
        && request.resource.data.sourceModel == 'trainer'
        && request.resource.data.evidence.trainerUid == request.auth.uid
        && activeLink(request.auth.uid, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['finalRecordIds','reviewedAt','reviewedData']);
      allow create: if owner(uid) && approved() && draftShape()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny(['finalRecordIds','reviewedAt','reviewedData']);
      allow update: if owner(uid) && approved() && draftShape()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['pending','confirmed','rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','parsedData','uncertainty','evidence','updatedAt',
          'finalRecordIds','reviewedAt','reviewedData'
        ])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status == 'pending'
          || (request.resource.data.finalRecordIds is list
            && request.resource.data.finalRecordIds.size() <= 100
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedData is map));
      // 4.11.0 계정 삭제: 본인은 자기 검토함 초안을 지울 수 있다.
      allow list: if owner(uid);
      allow delete: if owner(uid);
    }
    // ---- 4.0.0 코치 모드: 대표님 결정으로 지금은 마스터 계정끼리만 쓴다(나중에 강사 승인 roles.trainer로 넓힘) ----
    // 5.0.2 관리자 또는 관리자가 코치 권한을 준 승인 계정
    function coachMaster() { return admin() || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coach', false) == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'); }
    function linkPath(t, m) { return /databases/$(database)/documents/links/$(t + '_' + m); }
    function activeLink(t, m) { return exists(linkPath(t, m)) && get(linkPath(t, m)).data.status == 'active'; }
    match /invites/{code} {
      allow get: if coachMaster();
      allow create: if coachMaster()
        && code.matches('^[A-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['code','trainerUid','trainerName','clientId','expiresAt','usedBy','createdAt'])
        && request.resource.data.code == code
        && request.resource.data.trainerUid == request.auth.uid
        && request.resource.data.trainerName is string && request.resource.data.trainerName.size() <= 60
        && request.resource.data.clientId is string && request.resource.data.clientId.size() <= 80
        && request.resource.data.usedBy == ''
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.createdAt == request.time;
      allow update: if coachMaster()
        && resource.data.usedBy == ''
        && resource.data.expiresAt > request.time
        && resource.data.trainerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if coachMaster() && resource.data.trainerUid == request.auth.uid;
    }
    match /links/{linkId} {
      function scopeOk(sc) { return sc is map && sc.keys().hasOnly(['sessions','workouts','diet','body']) && sc.sessions == true && sc.workouts is bool && sc.diet is bool && sc.body is bool; }
      allow get: if coachMaster() && (resource == null || resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      allow list: if coachMaster() && (resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      // 회원이 초대 코드를 쓴 그 묶음 안에서 연동을 만든다.
      allow create: if coachMaster()
        && request.resource.data.keys().hasOnly(['trainerUid','memberUid','trainerName','memberName','clientId','inviteCode','status','scope','shared','pt','schedule','consentAt','warnedMemberAt','warnedTrainerAt','createdAt','updatedAt'])
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.trainerUid != request.auth.uid
        && linkId == request.resource.data.trainerUid + '_' + request.auth.uid
        && request.resource.data.status == 'active'
        && scopeOk(request.resource.data.scope)
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.trainerUid == request.resource.data.trainerUid
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid
        && request.resource.data.consentAt == request.time
        && request.resource.data.warnedMemberAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // 회원: 공유 범위·공유 요약·끊기. 코치: 회차·예약·경고 확인·끊기. 끊긴 연동은 다시 살릴 수 없다(새로 초대).
      allow update: if coachMaster() && resource.data.status == 'active'
        && request.resource.data.status in ['active','ended']
        && request.resource.data.updatedAt == request.time
        && (
          (resource.data.memberUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scope','shared','status','endedAt','endedBy','memberName','attend','ptAgreedAt','routineLog','updatedAt'])
            && scopeOk(request.resource.data.scope)
            // 5.4.0 D6 전날 출석 응답: 예약 id → 'yes'|'change'|'no' (최대 60개)
            && (!('attend' in request.resource.data) || (request.resource.data.attend is map && request.resource.data.attend.size() <= 60))
            // 5.4.2 개인 루틴 했어요(루틴 id → 기록 목록, 최대 24개 루틴)
            && (!('routineLog' in request.resource.data) || (request.resource.data.routineLog is map && request.resource.data.routineLog.size() <= 24))
            // 5.4.0 D7 수강권 규칙 확인 시각
            && (!('ptAgreedAt' in request.resource.data) || (request.resource.data.ptAgreedAt is string && request.resource.data.ptAgreedAt.size() <= 40)))
          || (resource.data.trainerUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pt','schedule','trainerName','warnedTrainerAt','status','endedAt','endedBy','mealPlans','routines','updatedAt'])
            // 5.4.0 D15·D17 식단 제안·개인 운동 루틴: 목록, 각 최대 12개
            && (!('mealPlans' in request.resource.data) || (request.resource.data.mealPlans is list && request.resource.data.mealPlans.size() <= 12))
            && (!('routines' in request.resource.data) || (request.resource.data.routines is list && request.resource.data.routines.size() <= 12)))
        );
      allow delete: if false;
    }
    match /sessionAcks/{ackId} {
      allow get: if coachMaster() && (resource == null || resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      allow list: if coachMaster() && (resource.data.trainerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      allow create: if coachMaster()
        && request.resource.data.keys().hasOnly(['trainerUid','memberUid','memberName','sessionId','draftId','result','edits','feedback','ptDeduct','createdAt'])
        && request.resource.data.memberUid == request.auth.uid
        && ackId == request.resource.data.trainerUid + '_' + request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.result in ['confirmed','edited','rejected']
        && exists(linkPath(request.resource.data.trainerUid, request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /catalog/{kind}/items/{itemId} {
      function catalogKind() {
        return kind in ['foods','exercises','machineModels','gymLocations','gymMachines'];
      }
      // 4.27.0 전수검사 S-01: 헬스장 머신의 방식(spec)은 허용 목록 값만
      function validGymSpec(s) {
        return s is map
          && s.keys().hasOnly(['load','sided','unit','levelFirst','levelStep'])
          && (!('load' in s) || s.load in ['','plate','stack','cable','smith','body'])
          && (!('sided' in s) || s.sided in ['','both','iso','single'])
          && (!('unit' in s) || s.unit in ['','kg','lb','level'])
          && (!('levelFirst' in s) || s.levelFirst is number)
          && (!('levelStep' in s) || s.levelStep is number);
      }
      function validCatalog() {
        return catalogKind()
          && (kind != 'gymMachines' || !('spec' in request.resource.data) || request.resource.data.spec == null || validGymSpec(request.resource.data.spec))
          && request.resource.data.id == itemId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 160
          && request.resource.data.published == true
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow get, list: if approved() && catalogKind()
        && (resource.data.published == true || admin());
      allow create: if admin() && validCatalog()
        && request.resource.data.revision == 1;
      allow update: if admin() && validCatalog()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    // 3.14.0 익명 인기 집계: 이름·횟수·시각만. 한 번에 1씩만 늘릴 수 있고 지울 수 없다.
    match /popularity/{kind}/items/{itemId} {
      function popKind() { return kind in ['foods','exercises','machines']; }
      allow get, list: if approved() && popKind();
      allow create: if approved() && popKind()
        && request.resource.data.keys().hasOnly(['name','count','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if approved() && popKind()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /catalogRequests/{requestId} {
      function validNewRequest() {
        return request.resource.data.keys().hasOnly([
            'type','mode','name','manufacturer','model','gymName','targetIds','note',
            'servingQty','servingUnit','calories','carbs','protein','fat',
            'requesterUid','photoPath','wholePhotoDataUrl','nameplatePhotoDataUrl',
            'status','adminNote','createdAt','updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'type','mode','name','manufacturer','model','gymName','targetIds','note',
            'servingQty','servingUnit','calories','carbs','protein','fat',
            'requesterUid','photoPath','wholePhotoDataUrl','nameplatePhotoDataUrl',
            'status','adminNote','createdAt','updatedAt'
          ])
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.type in ['food','exercise','machine']
          && request.resource.data.mode in ['photo','manual']
          && request.resource.data.name is string && request.resource.data.name.size() <= 160
          && request.resource.data.manufacturer is string && request.resource.data.manufacturer.size() <= 160
          && request.resource.data.model is string && request.resource.data.model.size() <= 160
          && request.resource.data.gymName is string && request.resource.data.gymName.size() <= 160
          && request.resource.data.note is string && request.resource.data.note.size() <= 1000
          && request.resource.data.servingUnit is string
          && request.resource.data.servingUnit in ['', 'g', '개', '회']
          && (request.resource.data.servingQty == null || (request.resource.data.servingQty is number && request.resource.data.servingQty > 0))
          && (request.resource.data.calories == null || (request.resource.data.calories is number && request.resource.data.calories >= 0))
          && (request.resource.data.carbs == null || (request.resource.data.carbs is number && request.resource.data.carbs >= 0))
          && (request.resource.data.protein == null || (request.resource.data.protein is number && request.resource.data.protein >= 0))
          && (request.resource.data.fat == null || (request.resource.data.fat is number && request.resource.data.fat >= 0))
          && request.resource.data.targetIds is list && request.resource.data.targetIds.size() <= 24
          && request.resource.data.photoPath is string
          && request.resource.data.photoPath == ''
          && request.resource.data.wholePhotoDataUrl is string
          && request.resource.data.nameplatePhotoDataUrl is string
          && request.resource.data.wholePhotoDataUrl.size() <= 180000
          && request.resource.data.nameplatePhotoDataUrl.size() <= 180000
          && (request.resource.data.mode == 'manual'
            ? (request.resource.data.wholePhotoDataUrl == '' && request.resource.data.nameplatePhotoDataUrl == '')
            : (request.resource.data.type == 'machine'
              && request.resource.data.wholePhotoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')
              && request.resource.data.nameplatePhotoDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')))
          && request.resource.data.status == 'pending'
          && request.resource.data.adminNote == ''
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }
      allow get, list: if approved()
        && (resource.data.requesterUid == request.auth.uid || admin());
      allow create: if approved() && validNewRequest()
        && (admin() || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/meta/requestQuota).data.lastId == requestId);
      // 4.27.0 재검사 DOC-03: 계정 삭제 때 본인이 남긴 등록 요청(요청자 UID·사진 포함)도 지운다. 공용 도감에 실린 항목에는 요청자 정보가 없다.
      allow list: if signedIn() && resource.data.requesterUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.requesterUid == request.auth.uid;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','reviewerUid','updatedAt'])
        && request.resource.data.status in ['in_review','approved','rejected','needs_info']
        && request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 1000
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // ---- 5.0.0 로그메이트: 방 멤버끼리만, 방에 올린 것과 공개한 종류의 요약만 본다. 원본 기록(users/{uid})은 계속 본인만 ----
    function mateScopeOk(sc) {
      return sc is map && sc.keys().hasOnly(['body','meal','work']) && sc.keys().hasAll(['body','meal','work'])
        && sc.body is bool && sc.meal is bool && sc.work is bool;
    }
    function mateKind(k) { return k in ['body','meal','work']; }
    // 5.4.0 D1·D2 코치방: 코치·회원 연동(links)이 살아 있을 때 둘만의 방. 공개 범위는 방이 아니라 연동의 동의 범위를 따른다.
    function coachLink(id) { return get(/databases/$(database)/documents/links/$(id)).data; }
    function coachRoomCreateOk(d) {
      return d.keys().hasOnly(['name','type','ownerUid','memberIds','memberNames','scope','joinCode','appliedProposal','linkId','createdAt','updatedAt'])
        && d.type == 'coach' && mateNameOk(d.name) && d.linkId is string
        && coachLink(d.linkId).status == 'active'
        && (request.auth.uid == coachLink(d.linkId).trainerUid || request.auth.uid == coachLink(d.linkId).memberUid)
        && d.ownerUid == request.auth.uid
        && d.memberIds == [coachLink(d.linkId).trainerUid, coachLink(d.linkId).memberUid]
        && d.memberNames is map && d.memberNames.keys().hasOnly([coachLink(d.linkId).trainerUid, coachLink(d.linkId).memberUid])
        && mateScopeOk(d.scope) && d.joinCode == '' && d.appliedProposal == ''
        && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function coachScopeOn(r, k) {
      return coachLink(r.linkId).status == 'active'
        && ((k == 'body' && coachLink(r.linkId).scope.body == true) || (k == 'meal' && coachLink(r.linkId).scope.diet == true) || (k == 'work' && coachLink(r.linkId).scope.workouts == true));
    }
    function roomScopeOn(r, k) { return r.get('type', '') == 'coach' ? coachScopeOn(r, k) : r.scope[k] == true; }
    function mateNameOk(n) { return n is string && n.size() >= 1 && n.size() <= 30; }
    function mateMemberNamesOk(m) { return m is map && m.size() <= 50 && (!(request.auth.uid in m) || (m[request.auth.uid] is string && m[request.auth.uid].size() <= 20)); }
    // 5.4.9 대표님(2026-11-26): 방 정원은 무료 10명, 방장이 플러스(users/{uid}.plan == 'plus')면 50명
    function mateCap(ownerUid) { return exists(/databases/$(database)/documents/users/$(ownerUid)) && get(/databases/$(database)/documents/users/$(ownerUid)).data.get('plan', '') == 'plus' ? 50 : 10; }
    function mateInvite(code) { return get(/databases/$(database)/documents/mateInvites/$(code)).data; }
    function mateProposal(roomId, pid) { return getAfter(/databases/$(database)/documents/rooms/$(roomId)/proposals/$(pid)).data; }
    function mateJoinOk(roomId, was, now) {
      return !(request.auth.uid in was.memberIds) && was.type == 'friends'
        && now.diff(was).affectedKeys().hasOnly(['memberIds','memberNames','joinCode','updatedAt'])
        && now.memberIds == was.memberIds.concat([request.auth.uid]) && now.memberIds.size() <= mateCap(was.ownerUid)
        && now.memberNames.diff(was.memberNames).affectedKeys().hasOnly([request.auth.uid]) && mateMemberNamesOk(now.memberNames)
        && exists(/databases/$(database)/documents/mateInvites/$(now.joinCode))
        && mateInvite(now.joinCode).roomId == roomId
        && mateInvite(now.joinCode).expiresAt > request.time;
    }
    function mateLeaveOk(was, now) {
      return request.auth.uid in was.memberIds && request.auth.uid != was.ownerUid
        && now.diff(was).affectedKeys().hasOnly(['memberIds','memberNames','updatedAt'])
        && now.memberIds == was.memberIds.removeAll([request.auth.uid])
        && now.memberNames.diff(was.memberNames).affectedKeys().hasOnly([request.auth.uid]);
    }
    function mateOwnerOk(was, now) {
      return request.auth.uid == was.ownerUid && (
        (now.diff(was).affectedKeys().hasOnly(['ownerUid','updatedAt']) && now.ownerUid in was.memberIds)
        || (now.diff(was).affectedKeys().hasOnly(['name','updatedAt']) && mateNameOk(now.name)));
    }
    function mateMyNameOk(was, now) {
      return request.auth.uid in was.memberIds
        && now.diff(was).affectedKeys().hasOnly(['memberNames','updatedAt'])
        && now.memberNames.diff(was.memberNames).affectedKeys().hasOnly([request.auth.uid]) && mateMemberNamesOk(now.memberNames);
    }
    function mateScopeChangeOk(was, now, p) {
      return request.auth.uid in was.memberIds
        && now.diff(was).affectedKeys().hasOnly(['scope','appliedProposal','updatedAt'])
        && mateScopeOk(now.scope) && now.appliedProposal != was.appliedProposal
        && p.status == 'done' && p.yes.hasAll(was.memberIds)
        && now.scope[p.kind] == p.to
        && (p.kind == 'body' || now.scope.body == was.scope.body)
        && (p.kind == 'meal' || now.scope.meal == was.scope.meal)
        && (p.kind == 'work' || now.scope.work == was.scope.work);
    }
    match /rooms/{roomId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if approved() && roomId.matches('^[A-Za-z0-9]{12,24}$') && coachRoomCreateOk(request.resource.data);
      allow create: if approved()
        && roomId.matches('^[A-Za-z0-9]{12,24}$')
        && request.resource.data.keys().hasOnly(['name','type','ownerUid','memberIds','memberNames','scope','joinCode','appliedProposal','createdAt','updatedAt'])
        && mateNameOk(request.resource.data.name) && request.resource.data.type in ['friends','mine']
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.memberIds == [request.auth.uid]
        && mateMemberNamesOk(request.resource.data.memberNames) && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && mateScopeOk(request.resource.data.scope)
        && request.resource.data.joinCode == '' && request.resource.data.appliedProposal == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // 들어오기(초대 코드)·나가기(방장은 먼저 넘김)·방장 넘기기·방 이름·내 이름·공개 범위(전원 동의한 요청대로 한 종류만)
      allow update: if approved() && request.resource.data.updatedAt == request.time && (
        mateJoinOk(roomId, resource.data, request.resource.data)
        || mateLeaveOk(resource.data, request.resource.data)
        || mateOwnerOk(resource.data, request.resource.data)
        || mateMyNameOk(resource.data, request.resource.data)
        || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['scope'])
          && mateScopeChangeOk(resource.data, request.resource.data, mateProposal(roomId, request.resource.data.appliedProposal)))
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid && resource.data.memberIds.size() == 1;

      function room() { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
      function inRoom() { return signedIn() && request.auth.uid in room().memberIds; }
      match /posts/{postId} {
        allow get, list: if inRoom();
        allow create: if approved() && inRoom()
          && request.resource.data.keys().hasOnly(['uid','name','kind','text','photoKey','photoKind','takenAt','rec','createdAt','expireAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.kind in ['photo','text']
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && request.resource.data.rec is string && request.resource.data.rec.size() <= 80
          && request.resource.data.photoKind in ['scale','food','etc','']
          && request.resource.data.takenAt is timestamp && request.resource.data.takenAt <= request.time + duration.value(5, 'm')
          && request.resource.data.photoKey is string
          && ((request.resource.data.kind == 'text' && request.resource.data.photoKey == '' && request.resource.data.text.size() >= 1)
            || (request.resource.data.kind == 'photo' && request.resource.data.photoKey.matches('^rooms/' + roomId + '/' + request.auth.uid + '/[A-Za-z0-9_-]{8,40}[.](webp|jpg)$')))
          && request.resource.data.createdAt == request.time
          // 대표님(2026-11-25): 방의 대화·사진은 보관 기간(90일)만. 지나면 자동 삭제(Firestore TTL 'expireAt')
          && request.resource.data.expireAt is timestamp
          && request.resource.data.expireAt > request.time + duration.value(89, 'd')
          && request.resource.data.expireAt < request.time + duration.value(91, 'd');
        allow update: if false;
        // 쓴 사람은 언제든, 보관 기간(expireAt)이 지난 글은 방 메이트 누구나 지운다(TTL은 결제 요금제가 필요해 앱이 정리 — 2026-11-25)
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || (inRoom() && resource.data.expireAt is timestamp && resource.data.expireAt < request.time));
      }
      // 메이트에게 보여 줄 요약: 문서 이름은 '{uid}_{종류}'. 방이 그 종류를 공개할 때만 남이 읽는다(비공개로 바뀌면 바로 못 읽음).
      match /shares/{shareId} {
        allow get: if inRoom() && (resource == null || resource.data.uid == request.auth.uid || roomScopeOn(room(), resource.data.kind));
        allow create, update: if approved() && inRoom()
          && request.resource.data.keys().hasOnly(['uid','kind','name','data','updatedAt'])
          && request.resource.data.uid == request.auth.uid && mateKind(request.resource.data.kind)
          && shareId == request.auth.uid + '_' + request.resource.data.kind
          && roomScopeOn(room(), request.resource.data.kind)
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.data is map
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      // 공개 범위 변경 요청: 한 종류씩. 모두 동의하면 done, 한 명이라도 거절하면 rejected
      match /proposals/{pid} {
        allow get, list: if inRoom();
        allow create: if approved() && inRoom()
          && pid.matches('^[A-Za-z0-9]{8,24}$')
          && request.resource.data.keys().hasOnly(['kind','to','byUid','byName','yes','no','status','createdAt'])
          && mateKind(request.resource.data.kind) && request.resource.data.to is bool
          && request.resource.data.to != room().scope[request.resource.data.kind]
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 20
          && request.resource.data.yes == [request.auth.uid] && request.resource.data.no == []
          && (request.resource.data.status == 'open' || (request.resource.data.status == 'done' && [request.auth.uid].hasAll(room().memberIds)))
          && request.resource.data.createdAt == request.time;
        allow update: if inRoom() && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yes','no','status'])
          && (
            (!(request.auth.uid in resource.data.yes) && !(request.auth.uid in resource.data.no)
              && request.resource.data.yes == resource.data.yes.concat([request.auth.uid]) && request.resource.data.no == resource.data.no
              && (request.resource.data.status == 'open' || (request.resource.data.status == 'done' && request.resource.data.yes.hasAll(room().memberIds))))
            || (!(request.auth.uid in resource.data.yes) && !(request.auth.uid in resource.data.no)
              && request.resource.data.no == resource.data.no.concat([request.auth.uid]) && request.resource.data.yes == resource.data.yes
              && request.resource.data.status == 'rejected')
            || (request.resource.data.yes == resource.data.yes && request.resource.data.no == resource.data.no
              && request.resource.data.status == 'done' && resource.data.yes.hasAll(room().memberIds))
          );
        allow delete: if signedIn() && resource.data.byUid == request.auth.uid && resource.data.status == 'open';
      }
    }
    // 초대 링크·QR: 방 멤버 누구나 만든다(7일). 코드를 아는 승인된 사람만 읽는다.
    match /mateInvites/{code} {
      allow get: if approved();
      allow create: if approved()
        && code.matches('^[A-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['code','roomId','roomName','scope','inviterUid','inviterName','memberCount','expiresAt','createdAt'])
        && request.resource.data.code == code
        && request.resource.data.inviterUid == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.memberIds
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.type == 'friends'
        && request.resource.data.roomName is string && request.resource.data.roomName.size() <= 30
        && request.resource.data.inviterName is string && request.resource.data.inviterName.size() <= 20
        && mateScopeOk(request.resource.data.scope)
        && request.resource.data.memberCount is int && request.resource.data.memberCount <= 8
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }
    // ---- 5.0.1 마이태그(대표님 2026-11-25): 고유 닉네임. tags/{태그} 문서가 있으면 누군가의 것(중복 불가).
    // 영어는 전부 소문자 / 전부 대문자 / 첫 글자만 대문자만. 한글은 2자부터, 영어가 들어가면 3자부터. Moon·moon·MOON은 서로 다른 태그.
    // 바꾸면 이전 태그는 지워져 다른 사람이 쓸 수 있다.
    function tagOk(t) {
      return t is string && t.matches('^[가-힣A-Za-z0-9_]{2,16}$')
        && (t.matches('^[^A-Z]*$') || t.matches('^[^a-z]*$') || t.matches('^[A-Z][^A-Z]*$'))
        && (!t.matches('.*[A-Za-z].*') || t.size() >= 3)
        && !(t.lower() in ['admin','mylogue','마이로그','운영자','관리자','root','system','support'])
        // 5.0.6 보안 감사: 운영자·공식 계정을 흉내 내는 말이 '들어간' 태그도 막는다(mylogue_official, 마이로그운영팀 등)
        && !t.lower().matches('.*(admin|mylogue|마이로그|운영|관리자|official|support|staff).*');
    }
    function tagPath(key) { return /databases/$(database)/documents/tags/$(key); }
    match /tags/{key} {
      allow get: if approved();
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['uid','tag','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && tagOk(request.resource.data.tag) && request.resource.data.tag == key
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.tag == key
        && request.resource.data.updatedAt == request.time;
      allow update: if false;
      // 내 태그를 놓을 때만(프로필이 다른 태그로 바뀌었거나 지워질 때)
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.tag != key);
    }
    match /profiles/{uid} {
      allow get: if approved();
      allow create, update: if approved() && owner(uid)
        && request.resource.data.keys().hasOnly(['tag','updatedAt'])
        && tagOk(request.resource.data.tag)
        && getAfter(tagPath(request.resource.data.tag)).data.uid == uid
        // 이전 태그는 같은 묶음에서 놓아야 한다(한 사람에 하나)
        && (resource == null || resource.data.tag == request.resource.data.tag || !existsAfter(tagPath(resource.data.tag)))
        && request.resource.data.updatedAt == request.time;
      allow delete: if owner(uid) && !existsAfter(tagPath(resource.data.tag));
    }
    // 태그로 방 초대: 받는 사람에게 '초대받은 방'으로 보인다(수락하면 같은 초대 코드로 들어감)
    match /mateDirect/{id} {
      allow get, list: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['toUid','fromUid','fromTag','roomId','roomName','code','createdAt'])
        && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid != request.auth.uid
        && id == request.resource.data.toUid + '_' + request.resource.data.roomId
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.memberIds
        && get(/databases/$(database)/documents/mateInvites/$(request.resource.data.code)).data.roomId == request.resource.data.roomId
        && request.resource.data.fromTag is string && request.resource.data.fromTag.size() <= 16
        // 5.0.6 보안 감사: 보낸 사람 태그는 내 프로필 태그와 같아야 한다(남의 태그를 사칭해 초대하지 못하게). 태그가 없으면 빈 글자.
        && (request.resource.data.fromTag == ''
          ? !exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.tag == ''
          : get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.tag == request.resource.data.fromTag)
        && request.resource.data.roomName is string && request.resource.data.roomName.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }
  }
}
